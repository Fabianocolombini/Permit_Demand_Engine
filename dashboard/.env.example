# CARTO (Workspace → Developers)
# API base provided for this project:
CARTO_API_BASE=https://gcp-us-east1.api.carto.com

# API Access Token (Maps + SQL). Create under Developers → API Access Tokens.
# Prefer server-only CARTO_ACCESS_TOKEN. Use NEXT_PUBLIC_ only for deck.gl client sources.
CARTO_ACCESS_TOKEN=

# Optional public mirror for client-side deck.gl (scope grants tightly + referer lock).
# NEXT_PUBLIC_CARTO_ACCESS_TOKEN=

# Warehouse connection name in CARTO Workspace (default carto_dw).
CARTO_CONNECTION_NAME=carto_dw
